# ==========================================================================
#  Modelo de variáveis de ambiente para a VPS (Docker Compose).
#  Copie para ".env" na VPS e preencha com os valores REAIS.
#  NUNCA faça commit do .env — ele contém segredos.
# ==========================================================================

# --- Banco de dados (usado pelo Postgres E pelo app) ---
DB_NAME=urbano_connect_db
DB_USER=urbano
# Gere uma senha forte, ex: openssl rand -base64 24
DB_PASSWORD=TROQUE_POR_SENHA_FORTE

# --- Segurança JWT ---
# Gere um segredo forte, ex: openssl rand -base64 48
JWT_SECRET=TROQUE_POR_SEGREDO_FORTE

# --- E-mail (Hostinger SMTP) ---
MAIL_USERNAME=contato@seudominio.com
MAIL_PASSWORD=

# --- CORS / Frontend ---
# Origens permitidas (o domínio do front na Vercel/Hostinger). Sem barra no fim.
ALLOWED_ORIGINS=https://seudominio.com
FRONTEND_URL=https://seudominio.com

# --- Mercado Pago ---
# ATENÇÃO: gere um token NOVO no painel do MP (o antigo foi exposto).
MERCADO_PAGO_TOKEN=
MP_WEBHOOK_SECRET=

# --- APIs de cotação (opcionais) ---
ALPHA_VANTAGE_KEY=
BRAPI_TOKEN=
